def should_answer_question(text):
    norm = normalize(text)

    if not norm:
        return False

    question_words = {
        "где",
        "куда",
        "как",
        "кто",
        "сколько",
        "можно",
        "нужен",
        "нужна",
        "нужны",
        "подскажите",
        "посоветуйте",
        "порекомендуйте",
    }

    question_phrases = {
        "кто знает",
        "может кто знает",
        "есть ли",
        "кто-нибудь знает",
        "кто нибудь знает",
        "где можно",
        "как можно",
        "где найти",
        "где купить",
        "где взять",
        "где заказать",
        "где посмотреть",
        "как найти",
        "как купить",
        "как заказать",
        "как пополнить",
        "как привязать",
        "можно ли",
        "к кому обратиться",
        "у кого есть",
        "кто может",
        "кто подскажет",
        "кто посоветует",
    }

    words = set(norm.split())

    request_verbs = {
        "найти", "купить", "заказать", "снять", "арендовать",
        "пополнить", "привязать", "оплатить", "перевести",
        "отправить", "получить", "подключить", "посмотреть",
        "искать", "посоветуйте", "порекомендуйте",
    }

    has_request_verb = bool(words & request_verbs)
    has_question_word = bool(words & question_words)
    has_question_phrase = any(phrase in norm for phrase in question_phrases)

    return (
        "?" in text
        or has_question_word
        or has_question_phrase
        or has_request_verb
    )


