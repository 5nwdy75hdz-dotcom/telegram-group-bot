            delete_contact
        )
    )

    # Announcements admin
    application.add_handler(
        CommandHandler(
            "listannouncements",
            list_announcements
        )
    )

    application.add_handler(
        CommandHandler(
            "addannouncement",
            add_announcement
        )
    )

    application.add_handler(
        CommandHandler(
            "delannouncement",
            delete_announcement
        )
    )

    # Обычные сообщения
    application.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            handle_message
        )
    )

    application.add_error_handler(
        error_handler
    )

    logger.info(
        "Бот v0.3 запускается..."
    )

    application.run_polling(
        allowed_updates=Update.ALL_TYPES
    )


if __name__ == "__main__":
    main()
