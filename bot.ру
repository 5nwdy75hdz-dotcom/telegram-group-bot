def merge_defaults(data):
    if not isinstance(data, dict):
        data = {}

    if not isinstance(data.get("settings"), dict):
        data["settings"] = {}

    for key, value in DEFAULT_DATA["settings"].items():
        data["settings"].setdefault(key, value)

    if not isinstance(data.get("faq"), list):
        data["faq"] = []

    existing_ids = {
        item.get("id")
        for item in data["faq"]
        if isinstance(item, dict)
    }

    for item in DEFAULT_DATA["faq"]:
        if item["id"] not in existing_ids:
            data["faq"].append(item.copy())

    if not isinstance(data.get("contacts"), list):
        data["contacts"] = []

    if not isinstance(data.get("announcements"), list):
        data["announcements"] = []

    if not isinstance(data.get("rules"), list):
        data["rules"] = []

    return data


def load_data():
    if not DATA_FILE.exists():
        data = merge_defaults({})
        save_data(data)
        return data

    try:
        with DATA_FILE.open("r", encoding="utf-8") as f:
            data = json.load(f)

        data = merge_defaults(data)
        save_data(data)
        return data

    except Exception:
        logger.exception("Ошибка чтения knowledge.json")
        data = merge_defaults({})
        save_data(data)
        return data


def save_data(data):
    try:
        with DATA_FILE.open("w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
    except Exception:
        logger.exception("Ошибка записи knowledge.json")


DATA = load_data()


# ============================================================
# TEXT HELPERS
# ============================================================

def normalize(text):
    if not text:
        return ""

    text = text.lower().replace("ё", "е")

    # Убираем username и ссылки.
    text = re.sub(r"@\w+", " ", text)
    text = re.sub(r"https?://\S+", " ", text)

    # Пунктуация -> пробел.
    text = re.sub(r"[^a-zа-я0-9\s-]", " ", text)

    words = text.split()
    result = []

    for word in words:
        word = WORD_REPLACEMENTS.get(word, word)

        if word in STOP_WORDS:
            continue

        result.append(word)

    return " ".join(result)


def tokens(text):
    normalized = normalize(text)
    return set(normalized.split()) if normalized else set()


def similarity(a, b):
    a = normalize(a)
    b = normalize(b)

    if not a or not b:
        return 0.0

    return SequenceMatcher(None, a, b).ratio()


def contains_phrase(query_norm, phrase):
    phrase_norm = normalize(phrase)
    return bool(phrase_norm and phrase_norm in query_norm)


