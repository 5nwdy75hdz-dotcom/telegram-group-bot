async def handle_message(update: Update, context):
    if not update.message:
        return

    if not update.message.text:
        return

    text = update.message.text.strip()

    if not text:
        return

    # Команды обрабатываются отдельными handlers
    if text.startswith("/"):
        return

    intent = detect_intent(text)

    logger.info(
        "Запрос: %s | intent=%s",
        text,
        intent
    )

    # --------------------------------------------------------
    # ANNOUNCEMENTS
    # --------------------------------------------------------

    if intent == "announcement":
        results = find_announcements(text)

        if results:
            lines = [
                "📢 Нашёл актуальные объявления:\n"
            ]

            for _, item in results:
                lines.append(
                    format_announcement(item)
                )
                lines.append("")

            await update.message.reply_text(
                "\n".join(lines)
            )

            return

        # Если объявления не найдены,
        # не выдаём старые данные.
        await update.message.reply_text(
            "🔎 Похоже, ты ищешь актуальное объявление, "
            "но сейчас в базе ничего подходящего нет."
        )

        return

    # --------------------------------------------------------
    # CONTACTS
    # --------------------------------------------------------

    if intent == "contact":
        results = find_contacts(text)

        if results:
            lines = [
                "👥 Нашёл подходящие контакты:\n"
            ]

            for _, item in results:
                lines.append(
                    format_contact(item)
                )
                lines.append("")

            await update.message.reply_text(
                "\n".join(lines)
            )

            return

    # --------------------------------------------------------
    # FAQ
    # --------------------------------------------------------

    question_like = (
        "?" in text
        or any(
            word in normalize(text).split()
            for word in [
                "где",
                "как",
                "кто",
                "сколько",
                "можно",
                "нужен",
                "нужна",
                "подскажите"
            ]
        )
    )

    minimum_score = 3 if question_like else 6

    results = find_faq(
        text,
        minimum_score=minimum_score
    )

    if results:
        best_score, best_item = results[0]

        # Слишком слабое совпадение
        if best_score < minimum_score:
            return

        answer = best_item.get(
            "answer",
            "Информация не найдена."
        )

        source = format_source(
            best_item.get("source")
        )

        response = (
            f"🤖 {answer}"
            f"{source}"
        )

        await update.message.reply_text(
            response
        )

        return

    # --------------------------------------------------------
    # NOTHING FOUND
    # --------------------------------------------------------

    # В обычный групповой разговор бот не вмешивается.
    # Поэтому здесь НИЧЕГО не отправляем.


