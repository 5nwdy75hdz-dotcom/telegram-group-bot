def detect_intent(text):
    norm = normalize(text)

    if not norm:
        return "other"

    if "?" in text:
        if any(word in norm.split() for word in CONTACT_WORDS):
            return "contact"

    if any(word in norm.split() for word in CONTACT_WORDS):
        return "contact"

    if any(phrase in norm for phrase in ANNOUNCEMENT_WORDS):
        return "announcement"

    # Явные вопросы.
    question_words = {
        "где",
        "как",
        "кто",
        "сколько",
        "можно",
        "нужен",
        "нужна",
        "нужны",
        "подскажите",
        "посоветуйте",
    }

    if "?" in text or any(word in norm.split() for word in question_words):
        return "question"

    return "other"


# ============================================================
# FAQ SEARCH
# ============================================================

def score_faq(query, item):
    query_norm = normalize(query)
    query_tokens = tokens(query)

    if not query_norm:
        return 0

    score = 0

    question = item.get("question", "")
    answer = item.get("answer", "")
    keywords = item.get("keywords", [])
    category = item.get("category", "")

    question_norm = normalize(question)
    answer_norm = normalize(answer)

    # --------------------------------------------------------
    # 1. Сильный тематический сигнал
    # --------------------------------------------------------

    category_terms = CATEGORY_HINTS.get(category, set())
    category_hits = query_tokens & category_terms

    # Каждый тематический термин сильно влияет на результат.
    score += len(category_hits) * 15

    # --------------------------------------------------------
    # 2. Ключевые слова
    # --------------------------------------------------------

    keyword_tokens = set()

    for keyword in keywords:
        keyword_normalized = normalize(keyword)

        if not keyword_normalized:
            continue

        keyword_token_set = tokens(keyword)
        keyword_tokens.update(keyword_token_set)

        if keyword_normalized in query_norm:
            score += 5

    keyword_hits = query_tokens & keyword_tokens
    score += len(keyword_hits) * 4

    # --------------------------------------------------------
    # 3. Совпадение с формулировкой вопроса
    # --------------------------------------------------------

    question_tokens = tokens(question)
    question_hits = query_tokens & question_tokens

    score += len(question_hits) * 3

    # --------------------------------------------------------
    # 4. Семантическая похожесть формулировок
    # --------------------------------------------------------

    ratio = similarity(query, question)

    if ratio >= 0.80:
        score += 5
    elif ratio >= 0.65:
        score += 3
    elif ratio >= 0.50:
        score += 1

    # --------------------------------------------------------
    # 5. Совпадение с ответом
    # --------------------------------------------------------

    answer_tokens = tokens(answer)
    answer_hits = query_tokens & answer_tokens

    score += min(len(answer_hits), 2)

    # --------------------------------------------------------
    # 6. Город — только дополнительный сигнал
    # --------------------------------------------------------

    for city in CITIES:
        if city in query_norm:
            if city in question_norm:
                score += 2
            elif city in answer_norm:
                score += 1

    # --------------------------------------------------------
    # 7. Жёсткий штраф за конфликт тематики
    # --------------------------------------------------------
    #
    # Если в запросе есть сильный термин одной темы,
    # а FAQ относится к другой теме — снижаем результат.
    #
    # Например:
    # "стоматолог Гуанчжоу"
    #
    # housing имеет только "Гуанчжоу", но medicine имеет
    # "стоматолог". Поэтому жильё не должно побеждать.
    # --------------------------------------------------------

    all_category_hits = {}

    for cat, terms in CATEGORY_HINTS.items():
        hits = query_tokens & terms
        if hits:
            all_category_hits[cat] = len(hits)

    if all_category_hits:
        strongest_category = max(
            all_category_hits,
            key=all_category_hits.get
        )

        if strongest_category != category:
            strongest_hits = all_category_hits[strongest_category]

            if strongest_hits >= 1:
                score -= 12

            if strongest_hits >= 2:
                score -= 8

    return score


def find_faq(query):
    results = []

    for item in DATA.get("faq", []):
        if not isinstance(item, dict):
            continue

        score = score_faq(query, item)

        if score > 0:
            results.append((score, item))

    results.sort(key=lambda x: x[0], reverse=True)

    return results


# ============================================================
# CONTACT SEARCH
# ============================================================

def score_contact(query, item):
    query_tokens = tokens(query)

    if not query_tokens:
        return 0

    text_parts = [
        item.get("name", ""),
        item.get("category", ""),
        item.get("service", ""),
        item.get("city", ""),
        item.get("contact", ""),
        item.get("comment", ""),
    ]

    searchable = " ".join(text_parts)
    item_tokens = tokens(searchable)

    score = len(query_tokens & item_tokens) * 5

    category = normalize(item.get("category", ""))

    for cat, hints in CATEGORY_HINTS.items():
        if category == cat:
            score += len(query_tokens & hints) * 8

    return score


def find_contacts(query):
    results = []

    for item in DATA.get("contacts", []):
        if not isinstance(item, dict):
            continue

        score = score_contact(query, item)

        if score > 0:
            results.append((score, item))

    results.sort(key=lambda x: x[0], reverse=True)

    return results[:DATA["settings"].get("max_search_results", 5)]


# ============================================================
# ANNOUNCEMENTS
# ============================================================

def parse_date(value):
    if not value:
        return None

    try:
        return datetime.strptime(value, "%Y-%m-%d").replace(
            tzinfo=timezone.utc
        )
    except Exception:
        return None


def is_announcement_active(item):
    if not isinstance(item, dict):
        return False

    if item.get("active") is False:
        return False

    expires_at = parse_date(item.get("expires_at"))

    if expires_at:
        return datetime.now(timezone.utc) <= expires_at

    created_at = parse_date(item.get("date"))

    if created_at:
        days = DATA["settings"].get("announcement_default_days", 3)
        return datetime.now(timezone.utc) <= (
            created_at + timedelta(days=days)
        )

    return True


def score_announcement(query, item):
    searchable = " ".join(
        [
            item.get("title", ""),
            item.get("text", ""),
            item.get("category", ""),
            item.get("city", ""),
        ]
    )

    return len(tokens(query) & tokens(searchable)) * 5


def find_announcements(query):
    results = []

    for item in DATA.get("announcements", []):
        if not is_announcement_active(item):
            continue

        score = score_announcement(query, item)

        if score > 0:
            results.append((score, item))

    results.sort(key=lambda x: x[0], reverse=True)

    return results[:DATA["settings"].get("max_search_results", 5)]


# ============================================================
# FORMATTERS
# ============================================================

def format_source(source):
    if not isinstance(source, dict):
        return ""

    parts = []

    chat = source.get("chat")
    date = source.get("date")
    message_id = source.get("message_id")

    if chat:
        parts.append(f"📍 {chat}")

    if date:
        parts.append(f"📅 {date}")

    if message_id:
        parts.append(f"📝 сообщение #{message_id}")

    if not parts:
        return ""

    return "\n\n" + " · ".join(parts)


def format_contact(item):
    parts = []

    name = item.get("name")
    service = item.get("service")
    city = item.get("city")
    contact = item.get("contact")
    comment = item.get("comment")

    if name:
        parts.append(f"👤 {name}")

    if service:
        parts.append(f"🔧 {service}")

    if city:
        parts.append(f"📍 {city}")

    if contact:
        parts.append(f"📞 {contact}")

    if comment:
        parts.append(f"💬 {comment}")

    source = item.get("source")

    result = "\n".join(parts)

    if source:
        result += format_source(source)

    return result


def format_announcement(item):
    title = item.get("title", "Актуальное объявление")
    text = item.get("text", "")
    city = item.get("city")
    date = item.get("date")
    expires_at = item.get("expires_at")

    result = f"📢 {title}\n"

    if city:
        result += f"📍 {city}\n"

    if date:
        result += f"📅 {date}\n"

    if expires_at:
        result += f"⏳ до {expires_at}\n"

    if text:
        result += f"\n{text}"

    source = item.get("source")

    if source:
        result += format_source(source)

    return result


