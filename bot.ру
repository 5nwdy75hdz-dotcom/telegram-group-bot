def extract_city(text):
    norm = normalize(text)
    words = set(norm.split())

    for canonical, aliases in CITY_ALIASES.items():
        if canonical in norm:
            return canonical
        if words & aliases:
            return canonical

    return None


def extract_services(text):
    query_tokens = tokens(text)
    found = []

    for service, hints in SERVICE_HINTS.items():
        hits = query_tokens & hints
        if hits:
            found.append((service, len(hits)))

    found.sort(key=lambda x: x[1], reverse=True)
    return [service for service, _ in found]


def extract_categories(text):
    query_tokens = tokens(text)
    found = []

    for category, hints in CATEGORY_HINTS.items():
        hits = query_tokens & hints
        if hits:
            found.append((category, len(hits)))

    found.sort(key=lambda x: x[1], reverse=True)
    return [category for category, _ in found]


def extract_entities(text):
    return {
        "city": extract_city(text),
        "services": extract_services(text),
        "categories": extract_categories(text),
    }


def extract_faq_city(item):
    """
    Определяет основной город FAQ-карточки.

    Приоритет:
    1. формулировка вопроса;
    2. ключевые слова;
    3. ответ.

    Это важно, если карточка относится к Фошаню, но в ответе
    дополнительно упоминается Гуанчжоу.
    """
    if not isinstance(item, dict):
        return None

    question = item.get("question", "")
    city = extract_city(question)
    if city:
        return city

    keywords_text = " ".join(
        str(x) for x in item.get("keywords", [])
    )
    city = extract_city(keywords_text)
    if city:
        return city

    return extract_city(item.get("answer", ""))


