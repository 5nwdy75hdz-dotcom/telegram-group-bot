def parse_date(value):
    if not value:
        return None

    try:
        return datetime.strptime(value, "%Y-%m-%d").replace(
            tzinfo=timezone.utc
        )
    except Exception:
        return None


def is_announcement_active(item):
    if not isinstance(item, dict):
        return False

    if item.get("active") is False:
        return False

    expires_at = parse_date(item.get("expires_at"))

    if expires_at:
        return datetime.now(timezone.utc) <= expires_at

    created_at = parse_date(item.get("date"))

    if created_at:
        days = DATA["settings"].get("announcement_default_days", 3)
        return datetime.now(timezone.utc) <= (
            created_at + timedelta(days=days)
        )

    return True


def score_announcement(query, item):
    searchable = " ".join(
        [
            item.get("title", ""),
            item.get("text", ""),
            item.get("category", ""),
            item.get("city", ""),
        ]
    )

    return len(tokens(query) & tokens(searchable)) * 5


def find_announcements(query):
    results = []

    for item in DATA.get("announcements", []):
        if not is_announcement_active(item):
            continue

        score = score_announcement(query, item)

        if score > 0:
            results.append((score, item))

    results.sort(key=lambda x: x[0], reverse=True)

    return results[:DATA["settings"].get("max_search_results", 5)]


