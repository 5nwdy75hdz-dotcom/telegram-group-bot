def score_contact(query, item):
    query_norm = normalize(query)
    query_tokens = tokens(query)

    score = 0

    category = item.get("category", "")
    city = item.get("city", "")
    name = item.get("name", "")
    description = item.get("description", "")
    services = item.get("services", [])

    searchable = " ".join(
        [
            str(category),
            str(city),
            str(name),
            str(description),
            " ".join(str(x) for x in services)
        ]
    )

    searchable_tokens = tokens(searchable)

    # Совпадение города
    if city and normalize(city) in query_norm:
        score += 7

    # Совпадение категории
    if category and normalize(category) in query_norm:
        score += 5

    # Слова услуг
    for service in services:
        if normalize(str(service)) in query_norm:
            score += 4

    # Общие совпадения
    score += len(query_tokens & searchable_tokens) * 2

    return score


def find_contacts(query):
    results = []

    for item in DATA.get("contacts", []):
        if not isinstance(item, dict):
            continue

        score = score_contact(query, item)

        if score >= 3:
            results.append((score, item))

    results.sort(
        key=lambda x: x[0],
        reverse=True
    )

    return results[:DATA["settings"]["max_search_results"]]


