async def add_faq(update: Update, context):
    if not await is_admin(update, context):
        return

    text = update.message.text

    payload = text.partition(" ")[2].strip()

    if "|" not in payload:
        await update.message.reply_text(
            "Формат:\n"
            "/addfaq вопрос | ответ"
        )
        return

    question, answer = [
        x.strip()
        for x in payload.split("|", 1)
    ]

    if not question or not answer:
        await update.message.reply_text(
            "Нужно указать и вопрос, и ответ."
        )
        return

    item_id = (
        f"faq_{len(DATA['faq']) + 1:03d}"
    )

    item = {
        "id": item_id,
        "category": "other",
        "question": question,
        "keywords": list(
            tokens(question)
        ),
        "answer": answer,
        "source": {}
    }

    DATA["faq"].append(item)

    save_data(DATA)

    await update.message.reply_text(
        f"✅ FAQ добавлен.\nID: {item_id}"
    )


