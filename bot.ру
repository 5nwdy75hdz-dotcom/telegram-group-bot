def save_data(data):
    temp_file = DATA_FILE.with_suffix(".tmp")

    with open(temp_file, "w", encoding="utf-8") as file:
        json.dump(
            data,
            file,
            ensure_ascii=False,
            indent=2
        )

    temp_file.replace(DATA_FILE)


def merge_defaults(data):
    """
    Добавляет отсутствующие разделы и стандартные FAQ,
    не уничтожая пользовательские данные.
    """

    changed = False

    if not isinstance(data, dict):
        data = copy.deepcopy(DEFAULT_DATA)
        save_data(data)
        return data

    # Разделы верхнего уровня
    for section in [
        "settings",
        "faq",
        "contacts",
        "announcements",
        "rules"
    ]:
        if section not in data:
            data[section] = copy.deepcopy(DEFAULT_DATA[section])
            changed = True

    # Настройки
    for key, value in DEFAULT_DATA["settings"].items():
        if key not in data["settings"]:
            data["settings"][key] = value
            changed = True

    # Добавляем стандартные FAQ только по отсутствующему ID
    existing_ids = {
        item.get("id")
        for item in data["faq"]
        if isinstance(item, dict)
    }

    for default_faq in DEFAULT_DATA["faq"]:
        if default_faq["id"] not in existing_ids:
            data["faq"].append(copy.deepcopy(default_faq))
            changed = True

    if changed:
        save_data(data)

    return data


def load_data():
    if not DATA_FILE.exists():
        data = copy.deepcopy(DEFAULT_DATA)
        save_data(data)
        return data

    try:
        with open(DATA_FILE, "r", encoding="utf-8") as file:
            data = json.load(file)

        return merge_defaults(data)

    except Exception as error:
        logger.error("Ошибка чтения knowledge.json: %s", error)

        backup_file = DATA_FILE.with_suffix(".broken.json")

        try:
            DATA_FILE.rename(backup_file)
        except Exception:
            pass

        data = copy.deepcopy(DEFAULT_DATA)
        save_data(data)

        return data


