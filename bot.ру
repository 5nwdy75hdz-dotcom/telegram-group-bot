def format_contact(item):
    name = item.get("name") or "Контакт"

    lines = [
        f"👤 {name}"
    ]

    city = item.get("city")

    if city:
        lines.append(f"📍 {city}")

    services = item.get("services", [])

    if services:
        lines.append(
            "🛠 " + ", ".join(
                str(x) for x in services
            )
        )

    description = item.get("description")

    if description:
        lines.append(
            f"ℹ️ {description}"
        )

    contact = item.get("contact")

    if contact:
        lines.append(
            f"📞 {contact}"
        )

    if item.get("verified"):
        verified_date = item.get(
            "verified_date"
        )

        if verified_date:
            lines.append(
                f"✅ Проверено: {verified_date}"
            )
        else:
            lines.append(
                "✅ Контакт отмечен как проверенный"
            )

    source = format_source(
        item.get("source")
    )

    if source:
        lines.append(source)

    return "\n".join(lines)


