def score_faq(query, item):
    query_norm = normalize(query)
    query_tokens = tokens(query)

    score = 0

    question = item.get("question", "")
    answer = item.get("answer", "")
    keywords = item.get("keywords", [])

    question_norm = normalize(question)
    answer_norm = normalize(answer)

    # Совпадение всей фразы
    if question_norm and question_norm in query_norm:
        score += 10

    # Похожие вопросы
    ratio = similarity(query, question)

    if ratio >= 0.75:
        score += 8
    elif ratio >= 0.60:
        score += 5
    elif ratio >= 0.45:
        score += 2

    # Ключевые слова
    keyword_tokens = set()

    for keyword in keywords:
        keyword_tokens.update(tokens(keyword))

        if normalize(keyword) in query_norm:
            score += 4

    # Пересечение слов
    score += len(query_tokens & keyword_tokens) * 3

    # Совпадения с самим вопросом
    question_tokens = tokens(question)
    score += len(query_tokens & question_tokens) * 2

    # Немного учитываем ответ
    answer_tokens = tokens(answer)
    score += min(
        len(query_tokens & answer_tokens),
        3
    )

    return score


def find_faq(query, minimum_score=4):
    results = []

    for item in DATA.get("faq", []):
        if not isinstance(item, dict):
            continue

        score = score_faq(query, item)

        if score >= minimum_score:
            results.append((score, item))

    results.sort(
        key=lambda x: x[0],
        reverse=True
    )

    return results[:DATA["settings"]["max_search_results"]]


