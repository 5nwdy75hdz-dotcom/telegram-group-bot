def detect_intent(text):
    normalized = normalize(text)
    word_set = set(normalized.split())

    announcement_score = 0
    contact_score = 0

    for phrase in ANNOUNCEMENT_WORDS:
        if phrase in normalized:
            announcement_score += 3

    for word in CONTACT_WORDS:
        if word in word_set:
            contact_score += 1

    # Явный вопрос про ближайшую поездку/передачу
    if any(
        phrase in normalized
        for phrase in [
            "кто летит",
            "кто едет",
            "кто может взять",
            "нужно передать",
            "могу взять"
        ]
    ):
        return "announcement"

    if announcement_score >= 3:
        return "announcement"

    if contact_score >= 1:
        return "contact"

    return "faq"


