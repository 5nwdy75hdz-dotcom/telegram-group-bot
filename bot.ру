def normalize(text):
    if not text:
        return ""

    text = text.lower().replace("ё", "е")

    # Убираем username и ссылки.
    text = re.sub(r"@\w+", " ", text)
    text = re.sub(r"https?://\S+", " ", text)

    # Пунктуация -> пробел.
    text = re.sub(r"[^a-zа-я0-9\s-]", " ", text)

    words = text.split()
    result = []

    for word in words:
        word = WORD_REPLACEMENTS.get(word, word)

        if word in STOP_WORDS:
            continue

        result.append(word)

    return " ".join(result)


def tokens(text):
    normalized = normalize(text)
    return set(normalized.split()) if normalized else set()


def similarity(a, b):
    a = normalize(a)
    b = normalize(b)

    if not a or not b:
        return 0.0

    return SequenceMatcher(None, a, b).ratio()


def contains_phrase(query_norm, phrase):
    phrase_norm = normalize(phrase)
    return bool(phrase_norm and phrase_norm in query_norm)


