def parse_datetime(value):
    if not value:
        return None

    try:
        return datetime.fromisoformat(
            value.replace("Z", "+00:00")
        )
    except Exception:
        return None


def is_announcement_active(item):
    expires_at = parse_datetime(
        item.get("expires_at")
    )

    if not expires_at:
        return True

    now = datetime.now(timezone.utc)

    if expires_at.tzinfo is None:
        expires_at = expires_at.replace(
            tzinfo=timezone.utc
        )

    return expires_at > now


def score_announcement(query, item):
    query_tokens = tokens(query)

    text = " ".join(
        [
            str(item.get("text", "")),
            str(item.get("category", "")),
            str(item.get("contact", "")),
            str(item.get("route", {}).get("from", "")),
            str(item.get("route", {}).get("to", "")),
        ]
    )

    item_tokens = tokens(text)

    score = len(query_tokens & item_tokens) * 3

    route = item.get("route", {})

    query_norm = normalize(query)

    route_from = normalize(
        str(route.get("from", ""))
    )

    route_to = normalize(
        str(route.get("to", ""))
    )

    if route_from and route_from in query_norm:
        score += 5

    if route_to and route_to in query_norm:
        score += 5

    return score


def find_announcements(query):
    results = []

    for item in DATA.get("announcements", []):
        if not isinstance(item, dict):
            continue

        if not is_announcement_active(item):
            continue

        score = score_announcement(
            query,
            item
        )

        if score >= 3:
            results.append((score, item))

    results.sort(
        key=lambda x: x[0],
        reverse=True
    )

    return results[:DATA["settings"]["max_search_results"]]


