# ============================================================
# MESSAGE HANDLER
# ============================================================

def should_answer_question(text):
    norm = normalize(text)

    if not norm:
        return False

    question_words = {
        "где",
        "как",
        "кто",
        "сколько",
        "можно",
        "нужен",
        "нужна",
        "нужны",
        "подскажите",
        "посоветуйте",
    }

    return (
        "?" in text
        or any(word in norm.split() for word in question_words)
    )


async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message:
        return

    text = update.message.text

    if not text:
        return

    # Не вмешиваемся в обычный чат.
    intent = detect_intent(text)

    # --------------------------------------------------------
    # Актуальные объявления
    # --------------------------------------------------------

    if intent == "announcement":
        announcements = find_announcements(text)

        if announcements:
            _, item = announcements[0]
            await update.message.reply_text(
                format_announcement(item)
            )
            return

    # --------------------------------------------------------
    # Контакты
    # --------------------------------------------------------

    if intent == "contact":
        contacts = find_contacts(text)

        if contacts:
            _, item = contacts[0]
            await update.message.reply_text(
                "📇 Нашёл контакт:\n\n" + format_contact(item)
            )
            return

        # Если контактов нет, не молчим, если есть подходящий FAQ.
        # Например "нужен стоматолог" пока ищется в FAQ.
        # Поэтому продолжаем ниже.

    # --------------------------------------------------------
    # FAQ / база знаний
    # --------------------------------------------------------

    results = find_faq(text)

    if not results:
        return

    best_score, best_item = results[0]

    question_like = should_answer_question(text)

    # Для вопроса нужен более низкий порог,
    # для обычного сообщения — более высокий.
    minimum_score = 5 if question_like else 10

    if best_score < minimum_score:
        return

    # Если есть явный тематический термин,
    # ответ должен быть достаточно уверенным.
    query_tokens = tokens(text)

    category_scores = {}

    for category, hints in CATEGORY_HINTS.items():
        hits = query_tokens & hints
        if hits:
            category_scores[category] = len(hits)

    if category_scores:
        strongest_category = max(
            category_scores,
            key=category_scores.get
        )

        if (
            best_item.get("category") != strongest_category
            and category_scores[strongest_category] >= 1
        ):
            # Не отдаём ответ из чужой категории.
            return

    answer = best_item.get("answer", "").strip()

    if not answer:
        return

    answer += format_source(best_item.get("source"))

    await update.message.reply_text(answer)


