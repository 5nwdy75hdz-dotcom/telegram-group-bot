def score_faq(query, item):
    query_norm = normalize(query)
    query_tokens = tokens(query)

    if not query_norm:
        return 0

    question = item.get("question", "")
    answer = item.get("answer", "")
    keywords = item.get("keywords", [])
    category = item.get("category", "")
    item_city = extract_faq_city(item)

    item_entities = extract_entities(
        " ".join(
            [
                question,
                answer,
                " ".join(str(x) for x in keywords),
            ]
        )
    )

    score = 0

    # 1. Категория — сильный сигнал.
    category_hits = query_tokens & CATEGORY_HINTS.get(category, set())
    score += len(category_hits) * 18

    # 2. Конкретная услуга — ещё сильнее.
    query_services = extract_services(query)
    item_services = item_entities["services"]

    service_overlap = set(query_services) & set(item_services)
    score += len(service_overlap) * 22

    # 3. Ключевые слова.
    keyword_tokens = set()

    for keyword in keywords:
        keyword_norm = normalize(keyword)
        if not keyword_norm:
            continue

        keyword_token_set = tokens(keyword)
        keyword_tokens.update(keyword_token_set)

        if keyword_norm in query_norm:
            score += 5

    keyword_hits = query_tokens & keyword_tokens
    score += len(keyword_hits) * 4

    # 4. Совпадение с формулировкой вопроса.
    question_tokens = tokens(question)
    score += len(query_tokens & question_tokens) * 3

    # 5. Общая похожесть текста.
    ratio = similarity(query, question)

    if ratio >= 0.82:
        score += 6
    elif ratio >= 0.70:
        score += 4
    elif ratio >= 0.55:
        score += 2

    # 6. Ответ тоже даёт небольшой сигнал.
    answer_hits = query_tokens & tokens(answer)
    score += min(len(answer_hits), 2)

    # 7. ГОРОД — теперь не просто бонус, а важный фильтр.
    query_city = extract_city(query)

    if query_city:
        if item_city == query_city:
            score += 20
        elif item_city and item_city != query_city:
            score -= 35
        else:
            # Вопрос содержит город, а карточка его явно не указывает.
            score -= 8

    # 8. Если пользователь явно назвал услугу,
    # чужая категория получает сильный штраф.
    query_categories = extract_categories(query)

    if query_categories and category not in query_categories:
        # Иногда есть пересечения вроде "аренда машины".
        # Поэтому штраф умеренный, но заметный.
        score -= 18

    # 9. Если есть конкретная услуга, а карточка про неё не знает,
    # не позволяем общему совпадению по городу/словам победить.
    if query_services and not service_overlap:
        score -= 10

    return score

def find_faq(query):
    """
    Ищем FAQ с учётом явно указанного города.

    Если пользователь назвал конкретный город и в базе есть FAQ
    именно для этого города, сначала ограничиваем поиск этим городом.
    Это важно для запросов вроде:
        "жильё в Фошане"
        "стоматолог в Шэньчжэне"

    Иначе общий FAQ по другой локации может получить высокий балл
    только из-за совпадения по теме.
    """

    query_city = extract_city(query)

    all_items = [
        item
        for item in DATA.get("faq", [])
        if isinstance(item, dict)
    ]

    # --------------------------------------------------------
    # 1. Если город указан — сначала ищем FAQ этого города.
    # --------------------------------------------------------
    if query_city:
        city_items = []

        for item in all_items:
            if extract_faq_city(item) == query_city:
                city_items.append(item)

        # Если для этого города есть карточки, НЕ смешиваем их
        # с карточками других городов.
        if city_items:
            search_items = city_items
        else:
            search_items = all_items
    else:
        search_items = all_items

    results = []

    for item in search_items:
        score = score_faq(query, item)

        if score > 0:
            results.append((score, item))

    results.sort(key=lambda x: x[0], reverse=True)

    return results[:DATA["settings"].get("max_search_results", 5)]


def faq_confidence(query, results):
    if not results:
        return 0.0

    best_score = results[0][0]

    if best_score <= 0:
        return 0.0

    # Нормализованная, намеренно консервативная оценка.
    confidence = min(best_score / 55.0, 1.0)

    if len(results) >= 2:
        second_score = results[1][0]
        if best_score - second_score < 5:
            confidence *= 0.75

    entities = extract_entities(query)

    if entities["city"]:
        item_text = " ".join(
            [
                results[0][1].get("question", ""),
                results[0][1].get("answer", ""),
                " ".join(str(x) for x in results[0][1].get("keywords", [])),
            ]
        )
        if extract_city(item_text) == entities["city"]:
            confidence = min(confidence + 0.15, 1.0)

    if entities["services"]:
        item_entities = extract_entities(
            " ".join(
                [
                    results[0][1].get("question", ""),
                    results[0][1].get("answer", ""),
                    " ".join(
                        str(x) for x in results[0][1].get("keywords", [])
                    ),
                ]
            )
        )
        if set(entities["services"]) & set(item_entities["services"]):
            confidence = min(confidence + 0.15, 1.0)

    return confidence


