def score_contact(query, item):
    query_tokens = tokens(query)

    if not query_tokens:
        return 0

    text_parts = [
        item.get("name", ""),
        item.get("category", ""),
        item.get("service", ""),
        item.get("city", ""),
        item.get("contact", ""),
        item.get("comment", ""),
    ]

    searchable = " ".join(text_parts)
    item_tokens = tokens(searchable)

    score = len(query_tokens & item_tokens) * 5

    query_city = extract_city(query)
    item_city = extract_city(searchable)

    if query_city:
        if item_city == query_city:
            score += 20
        elif item_city:
            score -= 30

    query_services = extract_services(query)
    item_services = extract_services(searchable)

    score += len(set(query_services) & set(item_services)) * 20

    category = normalize(item.get("category", ""))

    for cat, hints in CATEGORY_HINTS.items():
        if category == cat:
            score += len(query_tokens & hints) * 8

    return score

def find_contacts(query):
    results = []

    for item in DATA.get("contacts", []):
        if not isinstance(item, dict):
            continue

        score = score_contact(query, item)

        if score > 0:
            results.append((score, item))

    results.sort(key=lambda x: x[0], reverse=True)

    return results[:DATA["settings"].get("max_search_results", 5)]


