def format_source(source):
    if not isinstance(source, dict):
        return ""

    parts = []

    chat = source.get("chat")
    date = source.get("date")
    message_id = source.get("message_id")

    if chat:
        parts.append(f"📍 {chat}")

    if date:
        parts.append(f"📅 {date}")

    if message_id:
        parts.append(f"📝 сообщение #{message_id}")

    if not parts:
        return ""

    return "\n\n" + " · ".join(parts)


def format_contact(item):
    parts = []

    name = item.get("name")
    service = item.get("service")
    city = item.get("city")
    contact = item.get("contact")
    comment = item.get("comment")

    if name:
        parts.append(f"👤 {name}")

    if service:
        parts.append(f"🔧 {service}")

    if city:
        parts.append(f"📍 {city}")

    if contact:
        parts.append(f"📞 {contact}")

    if comment:
        parts.append(f"💬 {comment}")

    source = item.get("source")

    result = "\n".join(parts)

    if source:
        result += format_source(source)

    return result


def format_announcement(item):
    title = item.get("title", "Актуальное объявление")
    text = item.get("text", "")
    city = item.get("city")
    date = item.get("date")
    expires_at = item.get("expires_at")

    result = f"📢 {title}\n"

    if city:
        result += f"📍 {city}\n"

    if date:
        result += f"📅 {date}\n"

    if expires_at:
        result += f"⏳ до {expires_at}\n"

    if text:
        result += f"\n{text}"

    source = item.get("source")

    if source:
        result += format_source(source)

    return result


