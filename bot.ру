async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message:
        return

    text = update.message.text

    if not text:
        return

    intent = detect_intent(text)
    entities = extract_entities(text)

    # --------------------------------------------------------
    # Актуальные объявления
    # --------------------------------------------------------

    if intent == "announcement":
        announcements = find_announcements(text)

        if announcements:
            _, item = announcements[0]
            await update.message.reply_text(
                format_announcement(item)
            )
            return

    # --------------------------------------------------------
    # Контакты
    # --------------------------------------------------------

    if intent == "contact":
        contacts = find_contacts(text)

        if contacts and contacts[0][0] >= 15:
            # Если нашли уверенный реальный контакт — отдаём его.
            _, item = contacts[0]
            await update.message.reply_text(
                "📇 Нашёл контакт:\n\n" + format_contact(item)
            )
            return

    # --------------------------------------------------------
    # FAQ / база знаний
    # --------------------------------------------------------

    results = find_faq(text)

    if not results:
        return

    best_score, best_item = results[0]
    confidence = faq_confidence(text, results)

    question_like = should_answer_question(text)

    if question_like:
        STATS["questions_seen"] += 1

    # FAQ отвечаем/маршрутизируем только на сообщения,
    # которые действительно похожи на вопрос.
    # Обычная переписка с тематическими словами должна оставаться без ответа.
    # Это принципиальная защита от ложных срабатываний.
    if not question_like:
        STATS["ignored"] += 1
        return

    if best_score < 8 or confidence < 0.38:
        return

    # --------------------------------------------------------
    # Дополнительная проверка сущностей
    # --------------------------------------------------------

    query_city = entities["city"]

    if query_city:
        item_city = extract_faq_city(best_item)

        # Если человек назвал конкретный город,
        # не отвечаем карточкой другого города.
        if item_city and item_city != query_city:
            return

    query_services = entities["services"]

    if query_services:
        item_text = " ".join(
            [
                best_item.get("question", ""),
                best_item.get("answer", ""),
                " ".join(
                    str(x) for x in best_item.get("keywords", [])
                ),
            ]
        )
        item_services = extract_services(item_text)

        # При наличии конкретной услуги карточка должна
        # хотя бы тематически знать эту услугу.
        if not set(query_services) & set(item_services):
            # Для общих категорий допускаем fallback только
            # если результат очень уверенный.
            if confidence < 0.72:
                return

    # --------------------------------------------------------
    # Временно не отвечаем содержимым FAQ.
    # Если вопрос распознан достаточно уверенно, направляем
    # пользователя на @Bezen_Cargo.
    # --------------------------------------------------------

    # Если два результата практически равны, не перенаправляем
    # случайный вопрос не по теме.
    if len(results) >= 2:
        second_score = results[1][0]

        if best_score - second_score < 3 and confidence < 0.70:
            return

    STATS["redirected"] += 1
    await redirect_to_admin(update, context, text)


