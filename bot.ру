def format_source(source):
    if not source:
        return ""

    chat = source.get("chat")
    message_id = source.get("message_id")
    date = source.get("date")

    parts = []

    if chat:
        parts.append(f"📍 {chat}")

    if date:
        parts.append(f"📅 {date}")

    if message_id:
        parts.append(f"📝 сообщение #{message_id}")

    if not parts:
        return ""

    return "\n\n" + " · ".join(parts)


