    if route_from or route_to:
        lines.append(
            f"\n🛫 Маршрут: "
            f"{route_from or '?'} → {route_to or '?'}"
        )

    contact = item.get("contact")

    if contact:
        lines.append(
            f"📞 {contact}"
        )

    expires_at = item.get("expires_at")

    if expires_at:
        lines.append(
            f"⏳ Актуально до: {expires_at}"
        )

    source = format_source(
        item.get("source")
    )

    if source:
        lines.append(source)

    return "\n".join(lines)


